<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!-- 1. Local developer override (git-ignored). -->
  <Import Project="$(MSBuildThisFileDirectory)Environment.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Environment.props')" />

  <!-- 2. VALHEIM_INSTALL environment variable. -->
  <PropertyGroup Condition="'$(ValheimInstall)' == '' AND '$(VALHEIM_INSTALL)' != ''">
    <ValheimInstall>$(VALHEIM_INSTALL)</ValheimInstall>
  </PropertyGroup>

  <!-- 3. Best-effort auto-detection of common install locations. -->
  <PropertyGroup Condition="'$(ValheimInstall)' == ''">
    <_VhCandidate1>C:\Program Files (x86)\Steam\steamapps\common\Valheim</_VhCandidate1>
    <_VhCandidate2>C:\Program Files\Steam\steamapps\common\Valheim</_VhCandidate2>
    <_VhCandidate3>D:\SteamLibrary\steamapps\common\Valheim</_VhCandidate3>
    <_VhCandidate4>D:\Steam\steamapps\common\Valheim</_VhCandidate4>
    <_VhCandidate5>$(HOME)/.steam/steam/steamapps/common/Valheim</_VhCandidate5>
    <_VhCandidate6>$(HOME)/.local/share/Steam/steamapps/common/Valheim</_VhCandidate6>
    <_VhCandidate7>$(HOME)/Library/Application Support/Steam/steamapps/common/Valheim</_VhCandidate7>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ValheimInstall)' == ''">
    <ValheimInstall Condition="Exists('$(_VhCandidate1)\valheim_Data\Managed\assembly_valheim.dll')">$(_VhCandidate1)</ValheimInstall>
    <ValheimInstall Condition="'$(ValheimInstall)' == '' AND Exists('$(_VhCandidate2)\valheim_Data\Managed\assembly_valheim.dll')">$(_VhCandidate2)</ValheimInstall>
    <ValheimInstall Condition="'$(ValheimInstall)' == '' AND Exists('$(_VhCandidate3)\valheim_Data\Managed\assembly_valheim.dll')">$(_VhCandidate3)</ValheimInstall>
    <ValheimInstall Condition="'$(ValheimInstall)' == '' AND Exists('$(_VhCandidate4)\valheim_Data\Managed\assembly_valheim.dll')">$(_VhCandidate4)</ValheimInstall>
    <ValheimInstall Condition="'$(ValheimInstall)' == '' AND Exists('$(_VhCandidate5)/valheim_Data/Managed/assembly_valheim.dll')">$(_VhCandidate5)</ValheimInstall>
    <ValheimInstall Condition="'$(ValheimInstall)' == '' AND Exists('$(_VhCandidate6)/valheim_Data/Managed/assembly_valheim.dll')">$(_VhCandidate6)</ValheimInstall>
    <ValheimInstall Condition="'$(ValheimInstall)' == '' AND Exists('$(_VhCandidate7)/valheim_Data/Managed/assembly_valheim.dll')">$(_VhCandidate7)</ValheimInstall>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimManaged Condition="'$(ValheimManaged)' == '' AND '$(ValheimInstall)' != ''">$(ValheimInstall)/valheim_Data/Managed</ValheimManaged>
  </PropertyGroup>

  <!--
    BepInEx is resolved separately from the game on purpose. It does not always live
    inside the Valheim folder: Steam can move the game to another library without taking
    BepInEx with it, and mod managers such as r2modman keep BepInEx in a profile directory
    of their own. Only BepInEx.dll and 0Harmony.dll are needed, and both are stable.
  -->
  <PropertyGroup Condition="'$(BepInExCore)' == '' AND '$(BEPINEX_PATH)' != ''">
    <BepInExCore>$(BEPINEX_PATH)</BepInExCore>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BepInExCore)' == ''">
    <_BepCandidate0>$(ValheimInstall)/BepInEx/core</_BepCandidate0>
    <_BepCandidate1>$(_VhCandidate1)\BepInEx\core</_BepCandidate1>
    <_BepCandidate2>$(_VhCandidate2)\BepInEx\core</_BepCandidate2>
    <_BepCandidate3>$(_VhCandidate3)\BepInEx\core</_BepCandidate3>
    <_BepCandidate4>$(_VhCandidate4)\BepInEx\core</_BepCandidate4>
    <_BepCandidate5>$(_VhCandidate5)/BepInEx/core</_BepCandidate5>
    <_BepCandidate6>$(_VhCandidate6)/BepInEx/core</_BepCandidate6>
    <_BepCandidate7>$(_VhCandidate7)/BepInEx/core</_BepCandidate7>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BepInExCore)' == ''">
    <BepInExCore Condition="Exists('$(_BepCandidate0)/BepInEx.dll')">$(_BepCandidate0)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(_BepCandidate1)\BepInEx.dll')">$(_BepCandidate1)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(_BepCandidate2)\BepInEx.dll')">$(_BepCandidate2)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(_BepCandidate3)\BepInEx.dll')">$(_BepCandidate3)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(_BepCandidate4)\BepInEx.dll')">$(_BepCandidate4)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(_BepCandidate5)/BepInEx.dll')">$(_BepCandidate5)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(_BepCandidate6)/BepInEx.dll')">$(_BepCandidate6)</BepInExCore>
    <BepInExCore Condition="'$(BepInExCore)' == '' AND Exists('$(_BepCandidate7)/BepInEx.dll')">$(_BepCandidate7)</BepInExCore>
  </PropertyGroup>

</Project>
